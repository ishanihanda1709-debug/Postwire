# Copy this file to .env and fill it in. .env is git-ignored. Never commit real keys.

# ---- Branding ----
# APP_NAME=Postwire
# APP_TAGLINE=Today’s news, ready to post.

# ---- AI that writes the posts (pick ONE; or leave all empty to use the free copy-a-prompt route) ----
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Any OpenAI-compatible provider, including free local Ollama (no key needed):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=
# Each person may generate this many AI posts per day (repeats of a story you already opened are free):
# AI_DAILY_LIMIT=30
# Give the AI the full article text as well as the headline (off by default):
# FETCH_ARTICLE_TEXT=1

# ---- Accounts, trial and payment ----
# TRIAL_DAYS=7
# Shown on the Account and Upgrade pages:
# PRICE_LABEL=₹499 / month
# A payment link from your provider (for example a Razorpay Payment Link). Opens in a new tab.
# UPGRADE_URL=
# SUPPORT_EMAIL=
# Close sign-ins to new people (the first account is always allowed):
# ALLOW_SIGNUP=0
# Single-user mode on your own computer, no login at all:
# REQUIRE_LOGIN=0

# ---- Going live ----
# HOST=0.0.0.0
# Set when the site is served over HTTPS (it adds the Secure flag to the login cookie):
# COOKIE_SECURE=1
# Set when a proxy/host sits in front of the app and sends X-Forwarded-For:
# TRUST_PROXY=1
# Folder for all saved data. Use a persistent disk on your host:
# Where accounts and saved posts live. Default: a hidden .postwire folder in your home folder. On a host, point this at the persistent disk.
# DATA_DIR=/data

# ---- Landing page ----
# Set to 0 to hide the live headlines on the public landing page:
# PUBLIC_HEADLINES=0

# ---- News fetching ----
# Refresh once every morning instead of hourly (24h clock, comma-separated for several times):
# REFRESH_AT=09:00
# APP_TIMEZONE=Asia/Kolkata
# REFRESH_MINUTES=60
# Only show stories from the last N days (default 3):
# FRESH_DAYS=3

# Every new sign-up (name, email, dates; never the password) is posted to this Formspree form so you get an email.
# Leave it empty for no notifications. Keep your real form address out of the code and out of GitHub: set it here or in your host's settings.
# SIGNUP_FORM_URL=https://formspree.io/f/your-form-id

# Payments with Dodo Payments (subscriptions). Make the products in the Dodo dashboard, then set these on your host:
# DODO_API_KEY=            (Dodo dashboard > Developer > API keys)
# DODO_ENV=test            (test while trying it out, then live)
# DODO_PRODUCT_MONTHLY=    (product id of your monthly plan)
# DODO_PRODUCT_YEARLY=     (optional: product id of your yearly plan)
# DODO_WEBHOOK_SECRET=     (from the webhook you add in Dodo, starts with whsec_)
# PUBLIC_URL=https://postwire.in
# PRICE_LABEL=₹299 / month
# PRICE_LABEL_YEARLY=₹2,999 / year

# Free hosting without a disk: a free Upstash Redis database keeps accounts and saved posts. Set both, and set DATA_DIR=/tmp/postwire.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
