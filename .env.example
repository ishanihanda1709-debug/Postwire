# Copy this file to .env and fill it in. .env is git-ignored.
ANTHROPIC_API_KEY=
AUTHOR_NAME=Your Name
# REFRESH_MINUTES=60
# Refresh once every morning instead of hourly (24h clock, comma-separated for several times)
# REFRESH_AT=09:00
# APP_TIMEZONE=Asia/Kolkata

# --- Free / alternative AI (use INSTEAD of ANTHROPIC_API_KEY) ---
# Any OpenAI-compatible provider works. Examples:
#   Free local AI with Ollama (no key, runs on your computer):
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_MODEL=llama3.1
#   Other providers: use the base URL, model name and key from their docs.
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=

# Only show stories from the last N days (default 3)
# FRESH_DAYS=3
